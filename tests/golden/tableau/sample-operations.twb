            <remote-alias>line_count</remote-alias>
            <ordinal>4</ordinal>
            <local-type>integer</local-type>
          </metadata-record>
        </metadata-records>
      </connection>
      <aliases enabled='yes' />
      <column caption='Order type' datatype='string' name='[order_type]' role='dimension' type='nominal' />
      <column caption='Order lines' datatype='integer' name='[line_count]' role='measure' type='quantitative' />

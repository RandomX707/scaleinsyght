            <remote-type>3</remote-type>
            <local-name>[department_id]</local-name>
            <parent-name>[encounters]</parent-name>
            <remote-alias>department_id</remote-alias>
            <ordinal>3</ordinal>
            <local-type>integer</local-type>
          </metadata-record>
          <metadata-record class='column'>
            <remote-name>admitted_at</remote-name>
            <remote-type>7</remote-type>
            <local-name>[admitted_at]</local-name>
            <parent-name>[encounters]</parent-name>
            <remote-alias>admitted_at</remote-alias>
            <ordinal>5</ordinal>
            <local-type>datetime</local-type>
          </metadata-record>
          <metadata-record class='column'>
            <remote-name>discharged_at</remote-name>
            <remote-type>7</remote-type>
            <local-name>[discharged_at]</local-name>
            <parent-name>[encounters]</parent-name>
            <remote-alias>discharged_at</remote-alias>
            <ordinal>6</ordinal>
            <local-type>datetime</local-type>
          </metadata-record>
          <metadata-record class='column'>
            <remote-name>department_id</remote-name>
            <remote-type>3</remote-type>
            <local-name>[department_id (departments)]</local-name>
            <parent-name>[departments]</parent-name>
            <remote-alias>department_id</remote-alias>
            <ordinal>7</ordinal>
            <local-type>integer</local-type>
          </metadata-record>
          <metadata-record class='column'>
            <remote-name>department_name</remote-name>
            <remote-type>129</remote-type>
            <local-name>[department_name]</local-name>
            <parent-name>[departments]</parent-name>
            <remote-alias>department_name</remote-alias>
            <ordinal>9</ordinal>
            <local-type>string</local-type>
          </metadata-record>
        </metadata-records>
      </connection>
      <aliases enabled='yes' />
      <column caption='Department' datatype='string' name='[department_name]' role='dimension' type='nominal' />
      <column caption='Encounter count' datatype='integer' name='[Calculation_1001]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([encounter_id])' />
      </column>
      <column caption='Stay days' datatype='integer' name='[Calculation_1002]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='DATEDIFF(&apos;day&apos;, [admitted_at], [discharged_at]) // ignores [not_a_field]&#10;' />
      </column>
      <column caption='Long stay' datatype='string' name='[Calculation_1003]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_1002] &gt; 7 THEN &quot;Over a week marker&quot; ELSE &quot;Within a week marker&quot; END' />
      </column>
      <column caption='Above target' datatype='boolean' name='[Calculation_1004]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Calculation_1001] &gt; [Parameters].[Parameter 1]' />
      </column>
      <column caption='Ward' datatype='string' name='[Calculation_1005]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='UPPER([ward_code])' />
      </column>

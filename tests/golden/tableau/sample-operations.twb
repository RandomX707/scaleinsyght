    <datasource caption='Encounters by department' inline='true' name='federated.0sample1encounters' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='warehouse.riverside.example' name='postgres.0a1b2c3d4e5f6'>
            <connection authentication='username-password' class='postgres' dbname='riverside_operations' odbc-native-protocol='' one-time-sql='' port='5432' server='warehouse.riverside.example' sslmode='require' username='tableau_reader' />
          </named-connection>
        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation join='inner' type='join'>
          <clause type='join'>
            <expression op='='>
              <expression op='[encounters].[department_id]' />
              <expression op='[departments].[department_id]' />
            </expression>
          </clause>
          <relation connection='postgres.0a1b2c3d4e5f6' name='encounters' table='[public].[encounters]' type='table' />
          <relation connection='postgres.0a1b2c3d4e5f6' name='departments' table='[public].[departments]' type='table' />
        </_.fcp.ObjectModelEncapsulateLegacy.false...relation>
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation type='collection'>
          <relation connection='postgres.0a1b2c3d4e5f6' name='encounters' table='[public].[encounters]' type='table' />
          <relation connection='postgres.0a1b2c3d4e5f6' name='departments' table='[public].[departments]' type='table' />
        </_.fcp.ObjectModelEncapsulateLegacy.true...relation>
        <cols>
          <map key='[department_id (departments)]' value='[departments].[department_id]' />
          <map key='[department_id]' value='[encounters].[department_id]' />
        </cols>
        <metadata-records>
          <metadata-record class='column'>
            <remote-name>encounter_id</remote-name>
            <remote-type>3</remote-type>
            <local-name>[encounter_id]</local-name>

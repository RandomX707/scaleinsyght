{
  "name": "scale-insyght",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "db:setup": "tsx scripts/db-setup.ts",
    "tenant:create": "tsx scripts/tenant-create.ts",
    "tenant:create:test": "tsx scripts/tenant-create.ts --test",
    "demo:s1": "pnpm testbed:up && pnpm db:test:reset && pnpm db:migrate:test && pnpm exec concurrently -k -n api,worker,web \"pnpm exec tsx scripts/testbed-api-main.ts\" \"pnpm exec tsx scripts/testbed-worker-main.ts\" \"API_PROXY_TARGET=http://127.0.0.1:3310 pnpm --filter @scaleinsyght/web dev --host 127.0.0.1 --port 4184\"",
    "db:setup:sample": "tsx scripts/setup-sample-source.ts",
    "testbed:sqlserver:up": "tsx testbed/sqlserver/up.ts",
    "testbed:generate": "tsx testbed/generate.ts",
    "testbed:excel": "tsx testbed/excel/generate.ts",
    "testbed:up": "pnpm testbed:generate && tsx testbed/up.ts && pnpm testbed:sqlserver:up && pnpm testbed:truth",
    "testbed:truth": "tsx testbed/truth.ts",
    "dbt:sample": "tsx scripts/run-sample-dbt.ts",
    "models:list": "tsx scripts/list-models.ts",
    "test:live": "tsx scripts/test-live.ts",
    "eval:planner": "tsx scripts/eval-planner.ts",
    "eval:golden": "vitest run tests/unit/analytic-plan.test.ts tests/contracts/c3_gateway_security.test.ts",
    "backup:drill": "tsx scripts/backup-drill.ts",
    "test:load": "tsx scripts/test-load.ts",
    "gateway:start": "tsx scripts/customer-gateway.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:migrate:test": "tsx scripts/migrate.ts --test",
    "test:seed:golden": "tsx tests/support/seed-golden.ts",
    "db:test:reset": "tsx scripts/prepare-test-db.ts",
    "dev": "concurrently -k -n api,worker,web,sqlparse \"pnpm --filter @scaleinsyght/api dev\" \"pnpm --filter @scaleinsyght/worker dev\" \"pnpm --filter @scaleinsyght/web dev --host 127.0.0.1\" \"pnpm dev:sqlparse\"",
    "dev:sqlparse": "node scripts/sqlparse-dev.mjs",
    "test:sqlparse": "node scripts/sqlparse-test.mjs",
    "test": "vitest run tests/unit packages/ui/tests",
    "test:integration": "pnpm db:test:reset && pnpm db:migrate:test && vitest run tests/integration",
    "test:contracts": "pnpm db:test:reset && pnpm db:migrate:test && pnpm db:setup:sample && pnpm dbt:sample && vitest run tests/contracts",
    "test:e2e": "pnpm db:test:reset && pnpm db:migrate:test && pnpm test:seed:golden -- --test && playwright test",
    "test:testbed": "pnpm db:test:reset && pnpm db:migrate:test && pnpm exec vitest run tests/testbed && pnpm exec playwright test --config=playwright.testbed.config.ts",
    "lint": "eslint .",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "@scaleinsyght/analytic": "workspace:*",
    "@scaleinsyght/auth-oidc": "workspace:*",
    "@scaleinsyght/api": "workspace:*",
    "@scaleinsyght/artifacts": "workspace:*",
    "@scaleinsyght/classification": "workspace:*",
    "@scaleinsyght/connectors": "workspace:*",
    "@scaleinsyght/customer-gateway": "workspace:*",
    "@scaleinsyght/contracts": "workspace:*",
    "@scaleinsyght/db": "workspace:*",
    "@scaleinsyght/graph": "workspace:*",
    "@scaleinsyght/hub-adapters": "workspace:*",
    "@scaleinsyght/model-gateway": "workspace:*",
    "@scaleinsyght/reports": "workspace:*",
    "@scaleinsyght/policy": "workspace:*",
    "@scaleinsyght/profiler": "workspace:*",
    "@scaleinsyght/registry": "workspace:*",
    "@scaleinsyght/runner": "workspace:*",
    "dotenv": "^16.6.1",
    "exceljs": "^4.4.0",
    "fastify": "^5.6.2",
    "pdfkit": "^0.21.0",
    "pg": "^8.16.3",
    "pptxgenjs": "^4.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.56.1",
    "@types/node": "^22.19.0",
    "@types/pdfkit": "^0.17.7",
    "@types/pg": "^8.15.5",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.0",
    "globals": "^16.5.0",
    "node-pg-migrate": "^9.0.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.4",
    "vitest": "^3.2.4"
  }
}

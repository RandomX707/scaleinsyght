<?xml version='1.0' encoding='utf-8' ?>

<!-- Synthetic Tableau workbook in the documented .twb format, written by hand against the testbed dbt marts
     (testbed/dbt, built into si_testbed_pg's analytics schema) and the testbed's public tables. Fictional
     connection details. Expected lineage is in testbed/lineage-truth.json under "tableau". -->
<workbook original-version='18.1' source-build='2024.1.0 (20241.24.0312.0830)' source-platform='win' version='18.1' xmlns:user='http://www.tableausoftware.com/xml/user'>
  <document-format-change-manifest>
    <_.fcp.ObjectModelEncapsulateLegacy.true...ObjectModelEncapsulateLegacy />
    <_.fcp.ObjectModelTableType.true...ObjectModelTableType />
  </document-format-change-manifest>
  <datasources>
    <datasource caption='Department orders' inline='true' name='federated.1riverside0dept' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='warehouse.riverside.example' name='postgres.1a2b3c4d5e6f7'>
            <connection authentication='username-password' class='postgres' dbname='si_testbed_pg' odbc-native-protocol='' one-time-sql='' port='5432' server='warehouse.riverside.example' username='riverside_tableau' />
          </named-connection>
        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='postgres.1a2b3c4d5e6f7' name='mart_department_orders' table='[analytics].[mart_department_orders]' type='table' />
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation connection='postgres.1a2b3c4d5e6f7' name='mart_department_orders' table='[analytics].[mart_department_orders]' type='table' />
        <metadata-records>
          <metadata-record class='column'>
            <remote-name>department_id</remote-name>
            <remote-type>3</remote-type>
            <local-name>[department_id]</local-name>
            <parent-name>[mart_department_orders]</parent-name>
            <remote-alias>department_id</remote-alias>
            <ordinal>1</ordinal>
            <local-type>integer</local-type>
          </metadata-record>
          <metadata-record class='column'>
            <remote-name>department_name</remote-name>
            <remote-type>129</remote-type>
            <local-name>[department_name]</local-name>
            <parent-name>[mart_department_orders]</parent-name>
            <remote-alias>department_name</remote-alias>
            <ordinal>2</ordinal>
            <local-type>string</local-type>
          </metadata-record>
          <metadata-record class='column'>
            <remote-name>order_count</remote-name>
            <remote-type>20</remote-type>
            <local-name>[order_count]</local-name>
            <parent-name>[mart_department_orders]</parent-name>
            <remote-alias>order_count</remote-alias>
            <ordinal>3</ordinal>
            <local-type>integer</local-type>
          </metadata-record>
          <metadata-record class='column'>
            <remote-name>order_amount</remote-name>
            <remote-type>131</remote-type>
            <local-name>[order_amount]</local-name>
            <parent-name>[mart_department_orders]</parent-name>
            <remote-alias>order_amount</remote-alias>
            <ordinal>4</ordinal>
            <local-type>real</local-type>
          </metadata-record>
        </metadata-records>
      </connection>
      <aliases enabled='yes' />
      <column caption='Department' datatype='string' name='[department_name]' role='dimension' type='nominal' />
      <column caption='Orders' datatype='integer' name='[order_count]' role='measure' type='quantitative' />
      <column caption='Order amount' datatype='real' name='[order_amount]' role='measure' type='quantitative' />
      <column caption='Average order value' datatype='real' name='[Calculation_2001]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([order_amount]) / SUM([order_count])' />
      </column>
      <object-graph>
        <objects>
          <object caption='mart_department_orders' id='mart_department_orders_1A'>
            <properties context=''>
              <relation connection='postgres.1a2b3c4d5e6f7' name='mart_department_orders' table='[analytics].[mart_department_orders]' type='table' />
            </properties>
          </object>
        </objects>
      </object-graph>
    </datasource>
    <datasource caption='Provider workload' inline='true' name='federated.1riverside0prov' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='warehouse.riverside.example' name='postgres.1b3c4d5e6f7a8'>
            <connection authentication='username-password' class='postgres' dbname='si_testbed_pg' port='5432' server='warehouse.riverside.example' username='riverside_tableau' />
          </named-connection>
        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='postgres.1b3c4d5e6f7a8' name='mart_provider_encounters' table='[analytics].[mart_provider_encounters]' type='table' />
        <metadata-records>
          <metadata-record class='column'>
            <remote-name>provider_name</remote-name>
            <remote-type>129</remote-type>
            <local-name>[provider_name]</local-name>
            <parent-name>[mart_provider_encounters]</parent-name>
            <remote-alias>provider_name</remote-alias>
            <ordinal>2</ordinal>
            <local-type>string</local-type>
          </metadata-record>
          <metadata-record class='column'>
            <remote-name>specialty</remote-name>
            <remote-type>129</remote-type>
            <local-name>[specialty]</local-name>
            <parent-name>[mart_provider_encounters]</parent-name>
            <remote-alias>specialty</remote-alias>
            <ordinal>3</ordinal>
            <local-type>string</local-type>
          </metadata-record>
          <metadata-record class='column'>
            <remote-name>encounter_count</remote-name>
            <remote-type>20</remote-type>
            <local-name>[encounter_count]</local-name>
            <parent-name>[mart_provider_encounters]</parent-name>
            <remote-alias>encounter_count</remote-alias>
            <ordinal>4</ordinal>
            <local-type>integer</local-type>
          </metadata-record>
        </metadata-records>
      </connection>
      <column caption='Provider' datatype='string' name='[provider_name]' role='dimension' type='nominal' />
      <column caption='Encounters' datatype='integer' name='[encounter_count]' role='measure' type='quantitative' />
      <column caption='Busy provider' datatype='boolean' name='[Calculation_2002]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='SUM([encounter_count]) &gt;= 40 // threshold agreed with operations' />
      </column>
    </datasource>
    <datasource caption='Claims by department' inline='true' name='federated.1riverside0clms' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='warehouse.riverside.example' name='postgres.1c4d5e6f7a8b9'>
            <connection authentication='username-password' class='postgres' dbname='si_testbed_pg' port='5432' server='warehouse.riverside.example' username='riverside_tableau' />
          </named-connection>
        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='postgres.1c4d5e6f7a8b9' name='Custom SQL Query' type='text'>SELECT d.department_name, sum(c.claim_amount) AS claimed_amount, sum(c.order_amount) AS ordered_amount&#13;&#10;FROM analytics.mart_order_claims c&#13;&#10;JOIN public.departments d ON d.department_id = c.department_id&#13;&#10;WHERE c.order_amount &gt; 0&#13;&#10;GROUP BY d.department_name</_.fcp.ObjectModelEncapsulateLegacy.false...relation>
        <metadata-records>
          <metadata-record class='column'>
            <remote-name>department_name</remote-name>
            <remote-type>129</remote-type>
            <local-name>[department_name]</local-name>
            <parent-name>[Custom SQL Query]</parent-name>
            <remote-alias>department_name</remote-alias>
            <ordinal>1</ordinal>
            <local-type>string</local-type>
          </metadata-record>
          <metadata-record class='column'>
            <remote-name>claimed_amount</remote-name>
            <remote-type>131</remote-type>
            <local-name>[claimed_amount]</local-name>
            <parent-name>[Custom SQL Query]</parent-name>
            <remote-alias>claimed_amount</remote-alias>
            <ordinal>2</ordinal>
            <local-type>real</local-type>
          </metadata-record>
          <metadata-record class='column'>
            <remote-name>ordered_amount</remote-name>
            <remote-type>131</remote-type>
            <local-name>[ordered_amount]</local-name>
            <parent-name>[Custom SQL Query]</parent-name>
            <remote-alias>ordered_amount</remote-alias>
            <ordinal>3</ordinal>
            <local-type>real</local-type>
          </metadata-record>
        </metadata-records>
      </connection>
      <column caption='Department' datatype='string' name='[department_name]' role='dimension' type='nominal' />
      <column caption='Claimed' datatype='real' name='[claimed_amount]' role='measure' type='quantitative' />
      <column caption='Ordered' datatype='real' name='[ordered_amount]' role='measure' type='quantitative' />
    </datasource>
  </datasources>
  <worksheets>
    <worksheet name='Orders by department'>
      <table>
        <view>
          <datasources>
            <datasource caption='Department orders' name='federated.1riverside0dept' />
          </datasources>
          <datasource-dependencies datasource='federated.1riverside0dept'>
            <column-instance column='[department_name]' derivation='None' name='[none:department_name:nk]' pivot='key' type='nominal' />
            <column-instance column='[order_count]' derivation='Sum' name='[sum:order_count:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_2001]' derivation='User' name='[usr:Calculation_2001:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
        </view>
        <rows>[federated.1riverside0dept].[none:department_name:nk]</rows>
        <cols>([federated.1riverside0dept].[sum:order_count:qk] + [federated.1riverside0dept].[usr:Calculation_2001:qk])</cols>
      </table>
    </worksheet>
    <worksheet name='Provider workload'>
      <table>
        <view>
          <datasources>
            <datasource caption='Provider workload' name='federated.1riverside0prov' />
          </datasources>
          <datasource-dependencies datasource='federated.1riverside0prov'>
            <column-instance column='[provider_name]' derivation='None' name='[none:provider_name:nk]' pivot='key' type='nominal' />
            <column-instance column='[encounter_count]' derivation='Sum' name='[sum:encounter_count:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_2002]' derivation='None' name='[none:Calculation_2002:nk]' pivot='key' type='nominal' />
          </datasource-dependencies>
        </view>
        <rows>[federated.1riverside0prov].[none:provider_name:nk]</rows>
        <cols>[federated.1riverside0prov].[sum:encounter_count:qk]</cols>
      </table>
    </worksheet>
    <worksheet name='Claims by department'>
      <table>
        <view>
          <datasources>
            <datasource caption='Claims by department' name='federated.1riverside0clms' />
          </datasources>
          <datasource-dependencies datasource='federated.1riverside0clms'>
            <column-instance column='[department_name]' derivation='None' name='[none:department_name:nk]' pivot='key' type='nominal' />
            <column-instance column='[claimed_amount]' derivation='Sum' name='[sum:claimed_amount:qk]' pivot='key' type='quantitative' />
            <column-instance column='[ordered_amount]' derivation='Sum' name='[sum:ordered_amount:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
        </view>
        <rows>[federated.1riverside0clms].[none:department_name:nk]</rows>
        <cols>([federated.1riverside0clms].[sum:claimed_amount:qk] + [federated.1riverside0clms].[sum:ordered_amount:qk])</cols>
      </table>
    </worksheet>
  </worksheets>

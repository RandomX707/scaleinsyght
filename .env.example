DATABASE_URL=postgresql://si_app:replace-me@127.0.0.1:5432/scale_insyght
DATABASE_URL_WORKER=postgresql://si_worker:replace-me@127.0.0.1:5432/scale_insyght
DATABASE_URL_MIGRATE=postgresql://si_migrate:replace-me@127.0.0.1:5432/scale_insyght

# Local development only. Replace before exposing any service.
SESSION_SECRET=replace-with-a-random-local-secret
PUBLIC_APP_URL=http://localhost:5173
ARTIFACT_MASTER_KEY=replace-with-base64-for-a-random-32-byte-key
CONNECTION_SECRET_KEY=
ARTIFACT_VOLUME_PATH=.local/artifacts

# Local synthetic PostgreSQL connector source. `pnpm db:setup:sample` writes the generated URL/password to ignored .env.
DATABASE_URL_SAMPLE_SOURCE=
SAMPLE_SOURCE_PASSWORD=replace-me
DATABASE_URL_TESTBED=
SQLSERVER_TESTBED_HOST=
SQLSERVER_TESTBED_PORT=
SQLSERVER_TESTBED_DATABASE=
SQLSERVER_TESTBED_USERNAME=
SQLSERVER_TESTBED_PASSWORD=
SQLSERVER_TESTBED_ADMIN_PASSWORD=

# OpenAI-compatible model gateway. The API key is local only and is never committed.
MODEL_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
MODEL_DEFAULT=
MODEL_CHEAP=
# Planning model (decision 44); defaults to MODEL_DEFAULT. Set to a cheaper model to trade accuracy for cost.
MODEL_PLANNING=
# Daily model budget in USD: per workspace (tenant) and per person within it.
MODEL_DAILY_COST_CAP_USD=5
MODEL_DAILY_USER_COST_CAP_USD=1
MODEL_PRICING_JSON={}
LIVE_MODEL_TEST=0
# Exact HTTPS callback URI registered with the tenant identity provider
OIDC_REDIRECT_URI=
BACKUP_ENCRYPTION_KEY=
POSTGRES_PASSWORD=
SI_APP_PASSWORD=
SI_WORKER_PASSWORD=
SI_MIGRATE_PASSWORD=
CONTROL_PLANE_URL=
GATEWAY_CREDENTIAL=
GATEWAY_SOURCE_ID=
DEMO_MODE=false

# Optional: a separate test database per worktree (si_test or si_test_<suffix>), and E2E ports, for parallel work.
# SI_TEST_DATABASE=si_test
# E2E_API_PORT=3300
# E2E_WORKER_PORT=3301
# E2E_WEB_PORT=4174
# SQLPARSE_TEST_PORT=8031

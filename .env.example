DATABASE_URL=postgresql://si_app:replace-me@127.0.0.1:5432/scale_insyght
DATABASE_URL_WORKER=postgresql://si_worker:replace-me@127.0.0.1:5432/scale_insyght
DATABASE_URL_MIGRATE=postgresql://si_migrate:replace-me@127.0.0.1:5432/scale_insyght

# Local development only. Replace before exposing any service.
SESSION_SECRET=replace-with-a-random-local-secret
ARTIFACT_MASTER_KEY=replace-with-base64-for-a-random-32-byte-key
ARTIFACT_VOLUME_PATH=.local/artifacts

# Local synthetic PostgreSQL connector source. `pnpm db:setup:sample` writes the generated URL/password to ignored .env.
DATABASE_URL_SAMPLE_SOURCE=postgresql://si_source_ro:replace-me@127.0.0.1:5432/si_sample_source
SAMPLE_SOURCE_PASSWORD=replace-me

# OpenAI-compatible model gateway. The API key is local only and is never committed.
MODEL_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
MODEL_DEFAULT=
MODEL_CHEAP=
MODEL_DAILY_COST_CAP_USD=2
MODEL_DAILY_TOKEN_CAP=100000
MODEL_PRICING_JSON={}
LIVE_MODEL_TEST=0
# Exact HTTPS callback URI registered with the tenant identity provider
OIDC_REDIRECT_URI=
